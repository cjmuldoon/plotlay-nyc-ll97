	partition Properties = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/properties.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"property_id", "property_name", "borough", "cd", "primary_property_type", "gfa_uses", "site_eui", "lat", "lng", "emissions_2024", "limit_2024", "over_2024", "penalty_2024", "emissions_2030", "limit_2030", "over_2030", "penalty_2030", "pathway", "check", "in_totals"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"property_id", type text}, {"property_name", type text}, {"borough", type text}, {"cd", type text}, {"primary_property_type", type text}, {"gfa_uses", type number}, {"site_eui", type number}, {"lat", type number}, {"lng", type number}, {"emissions_2024", type number}, {"limit_2024", type number}, {"over_2024", type number}, {"penalty_2024", type number}, {"emissions_2030", type number}, {"limit_2030", type number}, {"over_2030", type number}, {"penalty_2030", type number}, {"pathway", type text}, {"check", type text}, {"in_totals", type logical}}, "en-US"),
				    ShortNames_primary_property_type_short = [#"Community Center and Social Meeting Hall" = "Community Center", #"Outpatient Rehabilitation/Physical Therapy" = "Outpatient Rehabilitation", #"Personal Services (Health/Beauty, Dry Cleaning, etc.)" = "Personal Services"],
				    Short_primary_property_type_short = Table.AddColumn(Typed, "primary_property_type_short", each Record.FieldOrDefault(ShortNames_primary_property_type_short, [primary_property_type], [primary_property_type]), type text)
				in
				    Short_primary_property_type_short

	annotation PBI_ResultType = Table
